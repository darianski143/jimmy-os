// JimmyOS Plymouth Script Theme
// - Black background
// - Logo at ~40% height
// - Spinner (throbber frames) at ~78% height (adjustable)

fun clamp(v, lo, hi) {
    if (v < lo) return lo;
    if (v > hi) return hi;
    return v;
}

// ---------- Load assets ----------
logo_img = Image("watermark.png");
bg_img = Image("background.png");

// Load throbber frames (assumes throbber-0001.png .. etc exist)
spinner_images = Array();
spinner_count = 0;

// Try to load up to 60 frames; stop when missing
for (i = 1; i <= 60; i++) {
    // Format number as 4 digits
    n = i;
    s = "";
    if (n < 10) s = "000" + n;
    else if (n < 100) s = "00" + n;
    else if (n < 1000) s = "0" + n;
    else s = "" + n;

    img = Image("throbber-" + s + ".png");
    if (img) {
        spinner_images[spinner_count] = img;
        spinner_count += 1;
    }
}

// Fallback: if no frames loaded, just keep empty array
spinner_index = 0;

// ---------- Create sprites ----------
bg_sprite = Sprite(bg_img);
bg_sprite.SetZ(-100); // în spate
logo_sprite = Sprite(logo_img);

spinner_sprite = Sprite();
if (spinner_count > 0) {
    spinner_sprite.SetImage(spinner_images[0]);
}

// ---------- Layout (THIS is where you move spinner) ----------
fun layout() {
    w = Window.GetWidth();
    h = Window.GetHeight();

    // Background image: stretch to screen
    bg_w = bg_img.GetWidth();
    bg_h = bg_img.GetHeight();
    bg_sprite.SetX(0);
    bg_sprite.SetY(0);

    // Unele build-uri au SetScale; dacă dă eroare, îți dau fallback mai jos
    bg_sprite.SetScale(w / bg_w, h / bg_h);


    // --- Logo position ---
    // 0.35 means 35% from top. Change if you want.
    logo_y_ratio = 0.35;

    // --- Spinner position ---
    // THIS is what you want: set it lower by increasing this (0.78 -> 0.82)
    spinner_y_ratio = 0.78;

    // Keep ratios in safe range
    logo_y_ratio = clamp(logo_y_ratio, 0.10, 0.90);
    spinner_y_ratio = clamp(spinner_y_ratio, 0.10, 0.95);

    // Center logo
    logo_w = logo_img.GetWidth();
    logo_h = logo_img.GetHeight();
    logo_x = (w - logo_w) / 2;
    logo_y = (h * logo_y_ratio) - (logo_h / 2);
    logo_sprite.SetX(logo_x);
    logo_sprite.SetY(logo_y);

    // Center spinner
    if (spinner_count > 0) {
        sp_w = spinner_images[0].GetWidth();
        sp_h = spinner_images[0].GetHeight();
        sp_x = (w - sp_w) / 2;
        sp_y = (h * spinner_y_ratio) - (sp_h / 2);
        spinner_sprite.SetX(sp_x);
        spinner_sprite.SetY(sp_y);
    }
}

// Call layout initially
layout();

// ---------- Animation ----------
fun refresh_callback() {
    // Advance spinner frame
    if (spinner_count > 0) {
        spinner_sprite.SetImage(spinner_images[spinner_index]);
        spinner_index += 1;
        spinner_index %= spinner_count;
    }
}

Plymouth.SetRefreshFunction(refresh_callback);

// Re-layout if needed (safe; some systems call this on res changes)
Plymouth.SetDisplayNormalFunction(layout);
Plymouth.SetDisplayPasswordFunction(layout);
Plymouth.SetDisplayQuestionFunction(layout);
